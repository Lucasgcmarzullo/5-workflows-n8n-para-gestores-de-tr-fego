        "jsCode": "return $input.all().map(i => {\n  const d = i.json;\n  const nomeCompleto = d.full_name || d.nome || d.name || 'tudo bem';\n  let tel = String(d.phone_number || d.telefone || d.phone || '').replace(/\\D/g, '');\n  if (tel && !tel.startsWith('55')) tel = '55' + tel;\n  return { json: { nome: nomeCompleto.split(' ')[0], nomeCompleto, telefone: tel, email: d.email || '' } };\n});"
      },
