          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: '55TROQUE_AQUI_NUMERO_DO_CLIENTE', text: $json.texto }) }}",
        "options": {}
      },
      "id": "f791cc64-8dcc-462a-b8a2-9083781fc650",
      "name": "Enviar Relatório",
