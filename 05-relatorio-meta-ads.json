      "name": "Buscar Dados Meta Ads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json.data && $input.first().json.data[0];\nif (!d) return [{ json: { texto: '📊 Sem dados de investimento ontem.' } }];\nconst gasto = parseFloat(d.spend || 0);\nconst tipos = ['lead', 'onsite_conversion.lead_grouped', 'onsite_conversion.messaging_conversation_started_7d'];\nconst act = (d.actions || []).find(a => tipos.includes(a.action_type));\nconst leads = act ? parseInt(act.value) : 0;\nconst brl = v => v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });\nconst texto = `📊 Relatório de ontem\\n\\n💰 Investido: ${brl(gasto)}\\n👁️ Impressões: ${d.impressions}\\n🖱️ Cliques: ${d.clicks}\\n🎯 Leads: ${leads}\\n📉 CPL: ${leads ? brl(gasto / leads) : '-'}`;\nreturn [{ json: { texto } }];"
      },
      "id": "8495960b-2964-4be1-8395-349df0d422e8",
      "name": "Montar Relatório",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://TROQUE_AQUI_URL_DA_SUA_API/message/sendText/TROQUE_AQUI_NOME_DA_INSTANCIA",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
